{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/recommendations/:id/observations.csv",
      "destination": "/api/observations?id=:id"
    }
  ]
}
