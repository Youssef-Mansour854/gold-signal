FRED_API_KEY=replace_with_your_32_character_fred_api_key
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DATABASE=gold_signal

# Optional: new additive data layer. Disabled by default; never changes the running SQLite bot.
# MONGO_DATA_LAYER_ENABLED=false
# GIT_COMMIT=your_deployment_commit_hash

# Optional: disposable replica set used only by the integration tests (must contain "test" in the DB name).
# TEST_MONGODB_URI=mongodb://localhost:27017/
# TEST_MONGODB_DATABASE=gold_signal_test

# Generic XAU/USD cost estimates per troy ounce, not broker-executed values.
GOLD_ESTIMATED_SPREAD_USD_PER_OUNCE=0.30
GOLD_ESTIMATED_SLIPPAGE_USD_PER_OUNCE_PER_SIDE=0.10
GOLD_ESTIMATED_COMMISSION_USD_PER_OUNCE_PER_SIDE=0.035
